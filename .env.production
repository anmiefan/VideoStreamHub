# ========================================
# Production Environment Configuration
# ========================================
# Copy this file to .env and update with your actual values

# Database Configuration
DATABASE_URL=postgresql://streaming_user:CHANGE_THIS_PASSWORD@localhost:5432/streaming_app
PGHOST=localhost
PGPORT=5432
PGDATABASE=streaming_app
PGUSER=streaming_user
PGPASSWORD=CHANGE_THIS_PASSWORD

# Application Configuration
NODE_ENV=production
PORT=5000

# Domain Configuration
DOMAIN=your-domain.com
SSL_ENABLED=true

# Security Configuration
SESSION_SECRET=CHANGE_THIS_TO_A_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_SECRET=CHANGE_THIS_TO_ANOTHER_RANDOM_STRING
BCRYPT_ROUNDS=12

# RTMP Configuration
RTMP_PORT=1935
RTMP_ALLOW_PUBLISH=127.0.0.1
HLS_PATH=/var/www/html/hls

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=500MB
ALLOWED_EXTENSIONS=mp4,mov,avi,mkv,webm

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# FFmpeg Configuration
FFMPEG_PATH=/usr/bin/ffmpeg
FFMPEG_PRESET=veryfast

# Webhook Configuration
WEBHOOK_SECRET=CHANGE_THIS_WEBHOOK_SECRET
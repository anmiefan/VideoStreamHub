# ========================================
# Docker Environment Configuration
# ========================================
# For use with Docker Compose deployment

# Database Configuration
POSTGRES_PASSWORD=your_secure_database_password
DATABASE_URL=postgresql://streaming_user:your_secure_database_password@postgres:5432/streaming_app

# Application Configuration
NODE_ENV=production
PORT=5000

# Domain Configuration
DOMAIN=your-domain.com

# Security Configuration
SESSION_SECRET=your_super_secret_session_key_minimum_32_characters
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# RTMP Configuration
RTMP_PORT=1935
HLS_PATH=/var/www/html/hls

# File Upload Configuration
UPLOAD_PATH=/app/uploads
MAX_FILE_SIZE=500MB

# Logging Configuration
LOG_LEVEL=info

# Redis Configuration
REDIS_URL=redis://redis:6379

# Webhook Configuration
WEBHOOK_SECRET=your_webhook_secret_key